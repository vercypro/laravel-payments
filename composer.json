{
    "name": "vercy/payments",
    "description": "Unified payment gateway integration for Laravel - Paystack, Flutterwave, Stripe, PayPal, NowPayments, Cryptomus, BitPay",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "payments",
        "paystack",
        "flutterwave",
        "stripe",
        "paypal",
        "crypto",
        "cryptomus",
        "nowpayments",
        "bitpay"
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Vercy\\Payments\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vercy\\Payments\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vercy\\Payments\\PaymentGatewayServiceProvider"
            ],
            "aliases": {
                "Payment": "Vercy\\Payments\\Facades\\Payment"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
